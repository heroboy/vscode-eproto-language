{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "eproto",
	"scopeName": "source.eproto",
	"fileTypes": [
		"epr"
	],
	"patterns": [
		{
			"include": "#comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#directives"
		},
		{
			"include": "#userclass"
		},
		{
			"include": "#enum"
		},
		{
			"include": "#struct"
		},
		{
			"include": "#message"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#terminators"
		}
	],
	"repository": {
		"comments": {
			"patterns": [
				{
					"name": "comment.line.double-slash.eproto",
					"begin": "//",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.eproto"
						}
					},
					"end": "$"
				},
				{
					"name": "comment.block.eproto",
					"begin": "/\\*",
					"beginCaptures": {
						"0": {
							"name": "punctuation.definition.comment.begin.eproto"
						}
					},
					"end": "\\*/",
					"endCaptures": {
						"0": {
							"name": "punctuation.definition.comment.end.eproto"
						}
					}
				}
			]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.eproto",
					"match": "\"[^\"\\r\\n]*\""
				}
			]
		},
		"numbers": {
			"patterns": [
				{
					"name": "constant.numeric.eproto",
					"match": "(?<![\\w.])-?(?:[0-9]+(?:\\.[0-9]+f?)?|\\.[0-9]+f?)"
				}
			]
		},
		"directives": {
			"patterns": [
				{
					"name": "meta.directive.eproto",
					"match": "(?i)^[ \\t]*(protoid|notwritedate|cppwithnsname|cppwriteprototools|interfacewithtableid|notostream|cppmultifile)[ \\t]*=[ \\t]*([0-9]+)[ \\t]*(;)?",
					"captures": {
						"1": {
							"name": "entity.name.tag.directive.eproto"
						},
						"2": {
							"name": "constant.numeric.directive.value.eproto"
						},
						"3": {
							"name": "punctuation.terminator.eproto"
						}
					}
				},
				{
					"name": "meta.directive.eproto",
					"match": "(?i)^[ \\t]*(interfacestyle|cpptojsonstyle|protousefor|serverlanguage|csharpeventstyle|tsmodulestyle)[ \\t]*=[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(;)?",
					"captures": {
						"1": {
							"name": "entity.name.tag.directive.eproto"
						},
						"2": {
							"name": "string.unquoted.directive.value.eproto"
						},
						"3": {
							"name": "punctuation.terminator.eproto"
						}
					}
				},
				{
					"name": "meta.directive.eproto",
					"match": "(?i)^[ \\t]*(protoname|cppprecompileheader|cppcodestyle)[ \\t]*=[ \\t]*([^\\s;]+)[ \\t]*(;)?",
					"captures": {
						"1": {
							"name": "entity.name.tag.directive.eproto"
						},
						"2": {
							"name": "string.unquoted.directive.value.eproto"
						},
						"3": {
							"name": "punctuation.terminator.eproto"
						}
					}
				},
				{
					"name": "meta.directive.eproto",
					"match": "(?i)^[ \\t]*(as3mainpackage|as3toolpackage)[ \\t]*=[ \\t]*([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)[ \\t]*(;)?",
					"captures": {
						"1": {
							"name": "entity.name.tag.directive.eproto"
						},
						"2": {
							"name": "string.unquoted.directive.value.eproto"
						},
						"3": {
							"name": "punctuation.terminator.eproto"
						}
					}
				},
				{
					"name": "meta.directive.eproto",
					"match": "(?i)^[ \\t]*(tsnamespace)[ \\t]*=[ \\t]*(\"[^\"\\r\\n]*\")[ \\t]*(;)?",
					"captures": {
						"1": {
							"name": "entity.name.tag.directive.eproto"
						},
						"2": {
							"name": "string.quoted.double.eproto"
						},
						"3": {
							"name": "punctuation.terminator.eproto"
						}
					}
				},
				{
					"name": "meta.directive.eproto",
					"match": "(?i)^[ \\t]*(namespace)[ \\t]*(?:=[ \\t]*)?([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(;)?",
					"captures": {
						"1": {
							"name": "entity.name.tag.directive.eproto"
						},
						"2": {
							"name": "string.unquoted.directive.value.eproto"
						},
						"3": {
							"name": "punctuation.terminator.eproto"
						}
					}
				},
				{
					"name": "meta.directive.eproto",
					"match": "(?i)^[ \\t]*(import)[ \\t]+(\"[^\"\\r\\n]*\")[ \\t]*(;)?",
					"captures": {
						"1": {
							"name": "entity.name.tag.directive.eproto"
						},
						"2": {
							"name": "string.quoted.double.eproto"
						},
						"3": {
							"name": "punctuation.terminator.eproto"
						}
					}
				}
			]
		},
		"userclass": {
			"patterns": [
				{
					"name": "meta.userclass.eproto",
					"begin": "(?m)^[ \\t]*(userclass)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]+(extends|public)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)",
					"beginCaptures": {
						"1": {
							"name": "keyword.declaration.userclass.eproto"
						},
						"2": {
							"name": "entity.name.type.userclass.eproto"
						},
						"3": {
							"name": "storage.modifier.extends.eproto"
						},
						"4": {
							"name": "entity.other.inherited-class.eproto"
						}
					},
					"end": ";",
					"endCaptures": {
						"0": {
							"name": "punctuation.terminator.eproto"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"name": "meta.userclass.attribute.eproto",
							"match": "(cppinclude|csharpnamespace|as3pack)\\b[ \\t]*=[ \\t]*(\"[^\"\\r\\n]*\")[ \\t]*(;)?",
							"captures": {
								"1": {
									"name": "entity.name.tag.userclass.eproto"
								},
								"2": {
									"name": "string.quoted.double.eproto"
								},
								"3": {
									"name": "punctuation.terminator.eproto"
								}
							}
						},
						{
							"include": "#strings"
						}
					]
				}
			]
		},
		"enum": {
			"patterns": [
				{
					"name": "meta.enum.eproto",
					"begin": "(?m)^[ \\t]*(enum)\\b(?:[ \\t]+(class)\\b)?[ \\t]*([A-Za-z_][A-Za-z0-9_]*)?[ \\t]*(?::[ \\t]*(char|uchar|byte|short|ushort|int|uint|long|ulong)\\b)?[ \\t]*(itemsafe\\b)?[ \\t]*(\\/\\/.*)?[ \\t]*(?=\\{|$)",
					"beginCaptures": {
						"1": {
							"name": "keyword.declaration.enum.eproto"
						},
						"2": {
							"name": "storage.modifier.class.eproto"
						},
						"3": {
							"name": "entity.name.type.enum.eproto"
						},
						"4": {
							"name": "storage.type.primitive.eproto"
						},
						"5": {
							"name": "storage.modifier.itemsafe.eproto"
						},
						"6": {
							"name": "comment.line.double-slash.eproto"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.block.end.enum.eproto"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"name": "meta.enum.member.eproto",
							"match": "([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?:=[ \\t]*([0-9]+))?[ \\t]*([,;])",
							"captures": {
								"1": {
									"name": "variable.other.enummember.eproto"
								},
								"2": {
									"name": "constant.numeric.enum-value.eproto"
								},
								"3": {
									"name": "punctuation.separator.enum.eproto"
								}
							}
						},
						{
							"match": "\\{",
							"name": "punctuation.section.block.begin.enum.eproto"
						},
						{
							"include": "#numbers"
						}
					]
				}
			]
		},
		"struct": {
			"patterns": [
				{
					"name": "meta.struct.eproto",
					"begin": "(?m)^[ \\t]*(struct)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?::[ \\t]*([0-9]+))?[ \\t]*((?:[^\\r\\n;{}\\/]|\\/(?![\\/\\*]))*?)[ \\t]*(\\/\\/.*)?[ \\t]*(?=\\{|$)",
					"beginCaptures": {
						"1": {
							"name": "keyword.declaration.struct.eproto"
						},
						"2": {
							"name": "entity.name.type.struct.eproto"
						},
						"3": {
							"name": "constant.numeric.struct-tag.eproto"
						},
						"4": {
							"name": "storage.modifier.eproto"
						},
						"5": {
							"name": "comment.line.double-slash.eproto"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.block.end.struct.eproto"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"include": "#field"
						},
						{
							"match": "\\{",
							"name": "punctuation.section.block.begin.struct.eproto"
						}
					]
				}
			]
		},
		"message": {
			"patterns": [
				{
					"name": "meta.message.eproto",
					"begin": "(?m)^[ \\t]*(message)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?::[ \\t]*([0-9]+))?[ \\t]*((?:[^\\r\\n;{}\\/]|\\/(?![\\/\\*]))*?)[ \\t]*(\\/\\/.*)?[ \\t]*(?=\\{|$)",
					"beginCaptures": {
						"1": {
							"name": "keyword.declaration.message.eproto"
						},
						"2": {
							"name": "entity.name.type.message.eproto"
						},
						"3": {
							"name": "constant.numeric.message-id.eproto"
						},
						"4": {
							"name": "storage.modifier.eproto"
						},
						"5": {
							"name": "comment.line.double-slash.eproto"
						}
					},
					"end": "\\}",
					"endCaptures": {
						"0": {
							"name": "punctuation.section.block.end.message.eproto"
						}
					},
					"patterns": [
						{
							"include": "#comments"
						},
						{
							"include": "#field"
						},
						{
							"match": "\\{",
							"name": "punctuation.section.block.begin.message.eproto"
						}
					]
				}
			]
		},
		"field": {
			"patterns": [
				{
					"include": "#fieldMsgtype"
				},
				{
					"include": "#fieldPrimitive"
				},
				{
					"include": "#fieldObject"
				}
			]
		},
		"fieldPrimitive": {
			"name": "meta.field.eproto",
			"match": "(?m)^[ \\t]*(?:(card)[ \\t]+)?(char|uchar|byte|short|ushort|int|long|uint|ulong|int64|longlong|uint64|ulonglong|float|double|bool|bitbool|string|u8string)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*:[ \\t]*([0-9]+)(?:[ \\t]*(\\[)[ \\t]*([0-9]+)?[ \\t]*(\\]))?[ \\t]*(?:=[ \\t]*((?:\\{[^}]*\\})|(?:\"[^\"\\r\\n]*\")|(?:[^\\s;]+)))?[ \\t]*((?:[A-Za-z_][A-Za-z0-9_]*[ \\t]*)*)(;)",
			"captures": {
				"1": {
					"name": "storage.modifier.card.eproto"
				},
				"2": {
					"name": "storage.type.primitive.eproto"
				},
				"3": {
					"name": "variable.other.field.eproto"
				},
				"4": {
					"name": "constant.numeric.field-id.eproto"
				},
				"5": {
					"name": "punctuation.definition.array.eproto"
				},
				"6": {
					"name": "constant.numeric.array-length.eproto"
				},
				"7": {
					"name": "punctuation.definition.array.eproto"
				},
				"8": {
					"name": "meta.field.default.eproto",
					"patterns": [
						{
							"include": "#numbers"
						},
						{
							"include": "#strings"
						},
						{
							"match": "\\b(?:true|false)\\b",
							"name": "constant.language.boolean.eproto"
						},
						{
							"match": "[A-Za-z_][A-Za-z0-9_]*",
							"name": "string.unquoted.eproto"
						}
					]
				},
				"9": {
					"name": "storage.modifier.field.eproto"
				},
				"10": {
					"name": "punctuation.terminator.field.eproto"
				}
			}
		},
		"fieldObject": {
			"name": "meta.field.eproto",
			"match": "(?m)^[ \\t]*(?:(card)[ \\t]+)?([A-Za-z_][A-Za-z0-9_]*)[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*:[ \\t]*([0-9]+)(?:[ \\t]*(\\[)[ \\t]*([0-9]+)?[ \\t]*(\\]))?[ \\t]*(?:=[ \\t]*((?:\\{[^}]*\\})|(?:\"[^\"\\r\\n]*\")|(?:[^\\s;]+)))?[ \\t]*((?:[A-Za-z_][A-Za-z0-9_]*[ \\t]*)*)(;)",
			"captures": {
				"1": {
					"name": "storage.modifier.card.eproto"
				},
				"2": {
					"name": "storage.type.object.eproto"
				},
				"3": {
					"name": "variable.other.field.eproto"
				},
				"4": {
					"name": "constant.numeric.field-id.eproto"
				},
				"5": {
					"name": "punctuation.definition.array.eproto"
				},
				"6": {
					"name": "constant.numeric.array-length.eproto"
				},
				"7": {
					"name": "punctuation.definition.array.eproto"
				},
				"8": {
					"name": "meta.field.default.eproto",
					"patterns": [
						{
							"include": "#numbers"
						},
						{
							"include": "#strings"
						},
						{
							"match": "\\b(?:true|false)\\b",
							"name": "constant.language.boolean.eproto"
						},
						{
							"match": "[A-Za-z_][A-Za-z0-9_]*",
							"name": "string.unquoted.eproto"
						}
					]
				},
				"9": {
					"name": "storage.modifier.field.eproto"
				},
				"10": {
					"name": "punctuation.terminator.field.eproto"
				}
			}
		},
		"fieldMsgtype": {
			"name": "meta.field.eproto",
			"match": "(?m)^[ \\t]*(?:(card)[ \\t]+)?(msgtype)\\b[ \\t]+([A-Za-z_][A-Za-z0-9_]*)[ \\t]*:[ \\t]*([0-9]+)[ \\t]*(;)",
			"captures": {
				"1": {
					"name": "storage.modifier.card.eproto"
				},
				"2": {
					"name": "storage.type.msgtype.eproto"
				},
				"3": {
					"name": "variable.other.field.eproto"
				},
				"4": {
					"name": "constant.numeric.field-id.eproto"
				},
				"5": {
					"name": "punctuation.terminator.field.eproto"
				}
			}
		},
		"terminators": {
			"patterns": [
				{
					"match": ";",
					"name": "punctuation.terminator.eproto"
				},
				{
					"match": "\\{",
					"name": "punctuation.section.block.begin.eproto"
				},
				{
					"match": "\\}",
					"name": "punctuation.section.block.end.eproto"
				}
			]
		}
	}
}
